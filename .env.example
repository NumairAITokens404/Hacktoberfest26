# Keep credentials server-side. The 26B-A4B model is the faster hosted Gemma 4 option.
GEMINI_API_KEY=
GEMMA_FAST_MODEL=gemma-4-26b-a4b-it
# Used only by the standalone reference FastAPI food service retained from the source repository.
GEMMA_MODEL=gemma-4-26b-a4b-it
# HTTP POST endpoint returning scores in the explicit 0..100 scale (not 0..1).
MODEL_API_URL=http://127.0.0.1:8000/predict
MODEL_API_KEY=
# Optional override. By default the X-ray endpoint is MODEL_API_URL with /predict replaced by /xray.
XRAY_API_URL=http://127.0.0.1:8000/xray
# Standalone research-only 2D brain MRI classifier.
MRI_API_URL=http://127.0.0.1:8003/mri
# Used only when running the standalone reference FastAPI services.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
